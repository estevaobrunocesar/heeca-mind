# Banco de dados (docker compose up -d sobe um Postgres local na porta 5433)
DATABASE_URL="postgresql://hecca:hecca_dev@localhost:5433/heeca_mind?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-me"
AUTH_URL="http://localhost:3000"

# Chave de cifragem de dados sensiveis (AES-256-GCM), 32 bytes em base64.
# NUNCA reutilize entre ambientes. Perder esta chave = perder os dados clinicos.
ENCRYPTION_KEY="troque-me"
# Rotação: chave(s) antiga(s), separadas por vírgula, só para decifrar. Ver docs/DEPLOY.md.
ENCRYPTION_KEY_PREVIOUS=""

# URL publica da aplicacao (usada nos links de agendamento e confirmacao)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Plataforma Heeca (portal): provisionamento, entitlement e SSO — heeca_site/docs/ENTITLEMENT.md
# Vazio = integração desligada (cadastro local em /cadastro). Em produção é obrigatório.
HEECA_PLATFORM_SECRET=""
HEECA_PORTAL_URL="https://heeca.com.br"

# WhatsApp — sempre pelo Heeca Notify (nenhum token da Meta aqui). console = só loga.
WHATSAPP_PROVIDER="console"
NOTIFY_URL="https://notify.heeca.com.br"
NOTIFY_SECRET=""
NOTIFY_PRODUCT="mind"

# Segredo do cron de notificacoes (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Storage de arquivos (fotos de perfil). local = public/uploads (dev / VPS); s3 = S3/R2/MinIO (serverless)
# E-mail: console (log), smtp ou resend. Avisos ao profissional, reset de senha e convites.
EMAIL_DRIVER="console"
EMAIL_FROM="Heeca Mind <no-reply@localhost>"
# smtp://usuario:senha@host:587 (STARTTLS) ou smtps://usuario:senha@host:465. Mailpit local: smtp://localhost:1025?starttls=0
SMTP_URL=""
RESEND_API_KEY=""

STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""
# Driver local: pasta dos documentos clínicos (blobs cifrados), fora de public/. Default: ./storage/private
PRIVATE_STORAGE_DIR=""

# Necessário fora da Vercel (Docker/VPS atrás de proxy) para o Auth.js confiar no Host
AUTH_TRUST_HOST="true"
# docker-compose.prod.yml
POSTGRES_PASSWORD=""
