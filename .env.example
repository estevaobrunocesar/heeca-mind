# Banco de dados (docker compose up -d sobe um Postgres local na porta 5433)
DATABASE_URL="postgresql://hecca:hecca_dev@localhost:5433/hecca_psico?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-me"
AUTH_URL="http://localhost:3000"

# Chave de cifragem de dados sensiveis (AES-256-GCM), 32 bytes em base64.
# NUNCA reutilize entre ambientes. Perder esta chave = perder os dados clinicos.
ENCRYPTION_KEY="troque-me"

# URL publica da aplicacao (usada nos links de agendamento e confirmacao)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp — Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
