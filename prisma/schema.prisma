// Heeca Mind — schema multi-tenant
//
// Convenções:
//  - Todo dado de negócio pertence a uma Organization (tenant). Queries devem
//    sempre filtrar por organizationId — ver src/lib/tenant.ts.
//  - Dados ADMINISTRATIVOS (Patient, Appointment) e CLÍNICOS (ClinicalNote)
//    vivem em tabelas separadas. Conteúdo clínico é cifrado na aplicação.
//  - Valores monetários em centavos (Int) para evitar float.
//  - Datas/horas em UTC (DateTime). Horários de grade semanal em "HH:mm".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────────────────────────
// TENANT / AUTENTICAÇÃO
// ───────────────────────────────────────────────────────────────

enum OrganizationType {
  SOLO // psicólogo autônomo
  CLINIC // clínica com vários profissionais
}

/// Segmento do tenant (docs/mind/01-ARQUITETURA.md §6). O MVP exibe só PSYCHOLOGY;
/// decide o tipo de registro profissional padrão (src/lib/registration.ts).
enum Segment {
  PSYCHOLOGY
  THERAPY
}

/// Espelho de `entitlement.access` do portal: BLOCKED manda o app inteiro para /bloqueado.
enum AccessState {
  OK
  WARNING
  BLOCKED
}

model Organization {
  id             String           @id @default(cuid())
  name           String
  type           OrganizationType @default(SOLO)
  slug           String?          @unique // página pública da clínica: /clinica/<slug>
  timezone       String           @default("America/Sao_Paulo")
  segment        Segment          @default(PSYCHOLOGY)

  // Conta/assinatura no portal heeca.com.br (heeca_site/docs/ENTITLEMENT.md; src/lib/heeca/).
  // O portal é dono de plano e cobrança; aqui só espelhamos o suficiente para o gate de acesso.
  heecaSubscriptionId String?     @unique
  heecaAccountId      String?
  planCode            String?
  planFeatures        String[]    @default([])
  planLimits          Json?
  accessState         AccessState @default(OK)
  entitlementSyncedAt DateTime?
  // Dados da conta vindos do portal (cadastro completo da clínica entra na etapa 2)
  document            String? // CPF/CNPJ só dígitos
  contactEmail        String?
  contactPhone        String?
  // Cadastro da clínica (§6) — o que aparece em documentos, página pública e mensagens
  legalName           String?
  whatsapp            String? // E.164
  website             String?
  instagram           String?
  logoUrl             String?
  logoKey             String?
  addressLine         String?
  addressCity         String?
  addressState        String?
  addressZip          String?
  offersOnline        Boolean     @default(true)
  offersInPerson      Boolean     @default(true)
  /// Anos de guarda após o último atendimento/exclusão antes de anonimizar (CFP: mínimo 5).
  retentionYears Int              @default(5)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  memberships         Membership[]
  professionals       Professional[]
  patients            Patient[]
  tags                Tag[]
  packages            Package[]
  packagePurchases    PackagePurchase[]
  documentTemplates   DocumentTemplate[]
  documentRequests    DocumentRequest[]
  commissionRules     CommissionRule[]
  commissionEntries   CommissionEntry[]
  commissionClosings  CommissionClosing[]
  appointments        Appointment[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  invitations         Invitation[]
  clinicalDelegations ClinicalDelegation[]
  waitlistEntries     WaitlistEntry[]
  formTemplates       FormTemplate[]
  formRequests        FormRequest[]

  @@map("organizations")
}

enum MembershipRole {
  OWNER // dono da conta / clínica
  PROFESSIONAL // psicólogo
  RECEPTIONIST // secretaria: agenda e contatos, sem acesso clínico
  FINANCE // financeiro: valores, pagamentos e comissões; agenda e pacientes só leitura; sem acesso clínico
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  emailVerifiedAt    DateTime?
  mfaEnabled         Boolean   @default(false)
  mfaSecretEnc       String? // TOTP secret cifrado (AES-GCM); presente antes de mfaEnabled durante a ativação
  mfaEnabledAt       DateTime?
  mfaRecoveryHashes  String[]  @default([]) // sha256 dos códigos de recuperação ainda não usados
  /// Avisos por e-mail ao profissional (src/lib/pro-notify-prefs.ts). null = tudo ligado.
  emailNotifications Json?
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships         Membership[]
  professional        Professional?
  passwordResetTokens PasswordResetToken[]
  mfaVerifications    MfaVerification[]
  sessions            UserSession[]
  accessLogs          AccessLog[]
  auditLogs           AuditLog[]
  clinicalNotes       ClinicalNote[]
  clinicalDocuments   ClinicalDocument[]
  clinicalDelegations ClinicalDelegation[]
  formRequestsSent    FormRequest[]

  @@map("users")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Convite para entrar na organização. O token vai por e-mail; aqui fica só o hash.
model Invitation {
  id             String         @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole
  tokenHash      String         @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/// Uma linha por login (o `sid` do JWT). Permite listar dispositivos e
/// revogar: requireActor() confere esta tabela a cada requisição.
model UserSession {
  sid           String    @id
  userId        String
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  ip            String?
  userAgent     String?
  revokedAt     DateTime?
  revokedReason String? // "user" | "password_reset" | "mfa_enabled" | "admin"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Prova, no servidor, de que a sessão `sid` passou pelo segundo fator.
/// O JWT só sai de mfaPending quando existe uma linha aqui — o cliente não
/// consegue forjar isso via update() da sessão.
model MfaVerification {
  sid       String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_verifications")
}

// ───────────────────────────────────────────────────────────────
// PROFISSIONAL / CONSULTÓRIO
// ───────────────────────────────────────────────────────────────

enum Modality {
  IN_PERSON
  ONLINE
  HYBRID // serviço aceita ambos; o agendamento concreto é IN_PERSON ou ONLINE
}

enum OnlinePlatform {
  GOOGLE_MEET
  ZOOM
  TEAMS
  OTHER
}

model Professional {
  id             String  @id @default(cuid())
  organizationId String
  userId         String? @unique // null = perfil gerido pela clínica sem login próprio

  // Identidade profissional
  displayName String // "Dra. Ana"
  fullName    String
  // Registro no conselho (CRP, CRN, CRFa…) — src/lib/registration.ts. Nulo quando o
  // perfil foi criado pelo provisionamento do portal e ainda não foi preenchido.
  registrationKind   String  @default("CRP")
  registrationNumber String? // exibido só onde o profissional autorizar
  showRegistration   Boolean @default(true)
  photoUrl    String? // URL pública (nossa ou externa)
  photoKey    String? // chave no storage quando a foto foi enviada por nós — permite apagar
  bio         String?
  approaches  String[] // ex.: ["TCC", "Psicanálise"]
  specialties String[] // ex.: ["Ansiedade", "Adolescentes"]

  // Contato
  phone     String?
  whatsapp  String? // E.164, ex.: +5511999999999
  email     String?
  instagram String?
  website   String?

  // Endereço do consultório
  addressLine  String?
  addressCity  String?
  addressState String?
  addressZip   String?

  // Página pública
  slug       String  @unique // app.com.br/agendar/<slug>
  showPrices Boolean @default(true)
  isActive   Boolean @default(true)

  // Atendimento online
  onlinePlatform  OnlinePlatform?
  onlineFixedLink String? // link fixo; se null, insere por sessão

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization                Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  services                    Service[]
  scheduleSettings            ScheduleSettings?
  policy                      ProfessionalPolicy?
  availability                AvailabilityRule[]
  blocks                      ScheduleBlock[]
  exceptions                  ScheduleException[]
  appointments                Appointment[]
  recurringSeries             RecurringSeries[]
  clinicalNotes               ClinicalNote[]
  clinicalDocuments           ClinicalDocument[]
  clinicalDelegationsGranted  ClinicalDelegation[] @relation("DelegationsGranted")
  clinicalDelegationsReceived ClinicalDelegation[] @relation("DelegationsReceived")
  waitlistEntries             WaitlistEntry[]
  formTemplates               FormTemplate[]
  formRequests                FormRequest[]
  packages                    Package[]
  packagePurchases            PackagePurchase[]
  documentTemplates           DocumentTemplate[]
  documentRequests            DocumentRequest[]
  commissionRules             CommissionRule[]
  commissionEntries           CommissionEntry[]
  commissionClosings          CommissionClosing[]

  @@index([organizationId])
  @@map("professionals")
}

model Service {
  id                  String   @id @default(cuid())
  professionalId      String
  name                String
  description         String?
  durationMinutes     Int
  priceCents          Int
  modality            Modality
  isActive            Boolean  @default(true)
  patientInstructions String? // orientações enviadas ao paciente
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  professional    Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  recurringSeries RecurringSeries[]

  @@index([professionalId, isActive])
  @@map("services")
}

// ───────────────────────────────────────────────────────────────
// CONFIGURAÇÃO DE AGENDA
// ───────────────────────────────────────────────────────────────

model ScheduleSettings {
  id             String @id @default(cuid())
  professionalId String @unique

  defaultDurationMinutes   Int  @default(50)
  bufferMinutes            Int  @default(10) // intervalo entre sessões
  slotStepMinutes          Int  @default(30) // granularidade dos horários oferecidos
  minAdvanceHours          Int  @default(24) // antecedência mínima p/ agendar
  minCancelHours           Int  @default(24)
  minRescheduleHours       Int  @default(24)
  maxSessionsPerDay        Int? // null = sem limite
  lateToleranceMinutes     Int  @default(15)
  maxBookingDaysAhead      Int  @default(60) // janela máxima visível na página pública
  confirmationTimeoutHours Int  @default(24) // solicitação pública expira se não confirmada

  updatedAt DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("schedule_settings")
}

model ProfessionalPolicy {
  id             String @id @default(cuid())
  professionalId String @unique

  cancellationPolicy String?
  noShowPolicy       String?
  reschedulePolicy   String?
  confirmationPolicy String?
  onlineInstructions String?
  paymentInfo        String?
  terms              String?
  /// D2: falta (NO_SHOW) consome uma sessão do pacote? Padrão sim — a hora foi reservada.
  noShowConsumesPackage Boolean @default(true)

  updatedAt DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("professional_policies")
}

/// Grade semanal recorrente. weekday: 0=domingo … 6=sábado.
model AvailabilityRule {
  id             String @id @default(cuid())
  professionalId String
  weekday        Int
  startTime      String // "HH:mm" no fuso da organização
  endTime        String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("availability_rules")
}

enum BlockType {
  BLOCK // bloqueio pontual
  DAY_OFF // folga
  VACATION // férias
}

/// Períodos em que o profissional NÃO atende (sobrepõe a grade semanal).
model ScheduleBlock {
  id             String    @id @default(cuid())
  professionalId String
  type           BlockType @default(BLOCK)
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime  @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startsAt, endsAt])
  @@map("schedule_blocks")
}

/// Horário excepcional: atende em data/horário fora da grade semanal.
model ScheduleException {
  id             String   @id @default(cuid())
  professionalId String
  date           DateTime @db.Date
  startTime      String
  endTime        String
  note           String?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, date])
  @@map("schedule_exceptions")
}

// ───────────────────────────────────────────────────────────────
// PACIENTES (dados administrativos)
// ───────────────────────────────────────────────────────────────

enum FollowUpStatus {
  ACTIVE
  PAUSED
  DISCHARGED // alta
  INACTIVE
}

enum PaymentMethod {
  PIX
  CASH
  CARD
  TRANSFER
  INSURANCE // convênio
  OTHER
}

model Patient {
  id             String @id @default(cuid())
  organizationId String

  name     String
  whatsapp String // E.164
  email    String?
  phone    String? // telefone alternativo (fixo, recado)
  birthDate DateTime? @db.Date

  // Endereço e contato de emergência: administrativos (para recibo e para ligar), nunca clínicos
  addressLine           String?
  addressCity           String?
  addressState          String?
  addressZip            String?
  emergencyContactName  String?
  emergencyContactPhone String? // E.164

  /// Preferências de comunicação (src/lib/comms-prefs.ts): { whatsapp, reminder24h, reminder2h }. null = tudo ligado.
  commsPrefs Json?
  /// Última sessão concluída — desnormalizado por transition(complete); base da reativação (§28).
  lastCompletedAt DateTime?

  usualModality          Modality?
  followUpStatus         FollowUpStatus @default(ACTIVE)
  adminNotes             String? // "prefere online", "precisa de recibo" — NUNCA conteúdo clínico
  needsReceipt           Boolean        @default(false)
  preferredPaymentMethod PaymentMethod?
  bestContactTime        String?

  firstAppointmentAt DateTime?
  lgpdConsentAt      DateTime? // aceite dos termos no agendamento público
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? // exclusão lógica (política de retenção LGPD)
  anonymizedAt       DateTime? // anonimização irreversível após o prazo de retenção

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  recurringSeries     RecurringSeries[]
  clinicalNotes       ClinicalNote[]
  clinicalDocuments   ClinicalDocument[]
  clinicalDelegations ClinicalDelegation[]
  waitlistEntries     WaitlistEntry[]
  formRequests        FormRequest[]
  notifications       Notification[]
  receipts            Receipt[]
  tags                PatientTag[]
  packagePurchases    PackagePurchase[]
  documentRequests    DocumentRequest[]
  portalTokens        PatientAccessToken[]
  portalSessions      PatientSession[]

  @@unique([organizationId, whatsapp])
  @@index([organizationId, name])
  @@index([organizationId, followUpStatus])
  @@index([organizationId, lastCompletedAt])
  @@map("patients")
}

// ───────────────────────────────────────────────────────────────
// AGENDAMENTOS
// ───────────────────────────────────────────────────────────────

/// Etiquetas administrativas do CRM ("convênio X", "indicação", "prefere manhã"). Nunca clínicas.
model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patients     PatientTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model PatientTag {
  patientId String
  tagId     String
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([patientId, tagId])
  @@index([tagId])
  @@map("patient_tags")
}

enum AppointmentStatus {
  PENDING // solicitado, aguardando ação
  AWAITING_CONFIRMATION // mensagem enviada, aguardando paciente
  CONFIRMED
  IN_PROGRESS // atendimento em andamento (§9 do briefing)
  CANCELLED_BY_PATIENT
  CANCELLED_BY_PROFESSIONAL
  RESCHEDULE_REQUESTED
  COMPLETED
  NO_SHOW
  AWAITING_PAYMENT
  EXPIRED // solicitação pública não confirmada no prazo
}

enum AppointmentModality {
  IN_PERSON
  ONLINE
}

enum AppointmentSource {
  PUBLIC_PAGE
  MANUAL
  RECURRING
  WAITLIST // horário oferecido a alguém da lista de espera
}

enum PaymentStatus {
  PENDING
  PAID
  WAIVED // isento / cortesia
  PACKAGE // coberto por um pacote de sessões (a receita é a venda do pacote)
}

enum PackagePurchaseStatus {
  ACTIVE
  EXHAUSTED // todas as sessões consumidas
  EXPIRED // passou a validade com saldo
  CANCELLED
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
}

model RecurringSeries {
  id             String              @id @default(cuid())
  professionalId String
  patientId      String
  serviceId      String
  frequency      RecurrenceFrequency
  weekday        Int
  startTime      String // "HH:mm"
  modality       AppointmentModality
  startsOn       DateTime            @db.Date
  endsOn         DateTime?           @db.Date
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id])
  appointments Appointment[]

  @@index([professionalId, isActive])
  @@map("recurring_series")
}

model Appointment {
  id             String  @id @default(cuid())
  organizationId String
  professionalId String
  patientId      String
  serviceId      String
  seriesId       String?

  startsAt DateTime
  endsAt   DateTime
  modality AppointmentModality
  status   AppointmentStatus   @default(PENDING)
  source   AppointmentSource   @default(MANUAL)

  // Snapshot do serviço no momento do agendamento
  serviceNameSnapshot String
  priceCents          Int
  durationMinutes     Int

  // Observações
  patientNote String? // texto livre do formulário público (não clínico)
  adminNote   String? // observação administrativa do profissional

  // Online
  onlineLink String?

  // Confirmação / cancelamento
  confirmationToken String?   @unique // usado no link "confirmar" do WhatsApp
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  completedAt       DateTime?

  // Financeiro básico
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  /// Sessão coberta por pacote (paymentStatus = PACKAGE). Consumo efetivo em PackageConsumption.
  packagePurchaseId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional      Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service           Service            @relation(fields: [serviceId], references: [id])
  series            RecurringSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  packagePurchase   PackagePurchase?   @relation(fields: [packagePurchaseId], references: [id], onDelete: SetNull)
  packageConsumption PackageConsumption?
  documentRequests  DocumentRequest[]
  payments          Payment[]
  notifications     Notification[]
  receipt           Receipt?
  clinicalNotes     ClinicalNote[]
  clinicalDocuments ClinicalDocument[]
  waitlistOffer     WaitlistEntry? // se este agendamento foi oferecido a partir da lista de espera
  formRequests      FormRequest[]

  @@index([professionalId, startsAt])
  @@index([organizationId, startsAt])
  @@index([patientId, startsAt])
  @@index([status])
  @@map("appointments")
}

/// Um recebimento: de uma sessão OU de um pacote (check constraint no SQL: exatamente um dos dois).
/// "Recebido no mês" = soma por paidAt, independente da origem.
model Payment {
  id                String        @id @default(cuid())
  appointmentId     String?
  packagePurchaseId String?
  amountCents       Int
  method            PaymentMethod
  paidAt            DateTime      @default(now())
  note              String?
  createdAt         DateTime      @default(now())

  appointment     Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  packagePurchase PackagePurchase? @relation(fields: [packagePurchaseId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([packagePurchaseId])
  @@index([paidAt])
  @@map("payments")
}

// ───────────────────────────────────────────────────────────────
// PACOTES DE SESSÕES (§20) — src/lib/packages/
// ───────────────────────────────────────────────────────────────

/// Catálogo: "Pacote 5 sessões, 90 dias". Pertence ao profissional (D1: serviços e pacotes por profissional).
model Package {
  id             String   @id @default(cuid())
  organizationId String
  professionalId String
  name           String
  description    String?
  sessionsCount  Int
  priceCents     Int
  validityDays   Int
  /// Serviços que o pacote cobre; vazio = qualquer serviço do profissional.
  serviceIds     String[] @default([])
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  purchases    PackagePurchase[]

  @@index([organizationId, professionalId, isActive])
  @@map("packages")
}

/// Venda a um paciente. Saldo = sessionsTotal − consumos não revertidos (calculado, nunca coluna).
model PackagePurchase {
  id             String                @id @default(cuid())
  organizationId String
  patientId      String
  packageId      String
  professionalId String
  nameSnapshot   String
  sessionsTotal  Int
  priceCents     Int
  serviceIds     String[]              @default([]) // snapshot da cobertura no momento da venda
  purchasedAt    DateTime              @default(now())
  expiresAt      DateTime
  status         PackagePurchaseStatus @default(ACTIVE)
  paymentStatus  PaymentStatus         @default(PENDING)
  cancelledAt    DateTime?
  cancelReason   String?
  note           String? // administrativo
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  package      Package              @relation(fields: [packageId], references: [id])
  professional Professional         @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  payments     Payment[]
  consumptions PackageConsumption[]
  appointments Appointment[]

  @@index([organizationId, patientId, status])
  @@index([expiresAt])
  @@map("package_purchases")
}

/// Uma sessão consumida do pacote. Reverter mantém a linha (histórico) com revertedAt.
// ───────────────────────────────────────────────────────────────
// DOCUMENTOS ADMINISTRATIVOS E CONSENTIMENTOS (§15) — src/lib/documents/
// Termos, contratos, políticas, autorizações. Em claro: guardam o que o paciente
// ACEITOU, não o que disse. Conteúdo clínico continua no prontuário cifrado.
// ───────────────────────────────────────────────────────────────

enum DocumentKind {
  CONSENT // termo de consentimento
  CONTRACT // contrato de prestação de serviços
  POLICY // política (cancelamento, faltas, pagamento)
  AUTHORIZATION // autorização (imagem, contato com terceiros…)
  OTHER
}

enum DocumentStatus {
  PENDING // enviado, não aberto
  VIEWED // aberto pelo link
  ACCEPTED // aceite registrado (nome, instante, IP, hash)
  EXPIRED // link venceu sem aceite
  REVOKED // cancelado pelo profissional
}

/// Modelo por profissional, versionado: salvar com texto/título diferente incrementa `version`.
/// Instâncias enviadas guardam o texto renderizado (snapshot), então editar o modelo nunca muda o que foi aceito.
model DocumentTemplate {
  id             String       @id @default(cuid())
  organizationId String
  professionalId String
  kind           DocumentKind @default(CONSENT)
  title          String
  /// Texto com variáveis {{paciente.nome}}, {{profissional.nome}}… (src/lib/documents/rules.ts).
  body           String
  version        Int          @default(1)
  isActive       Boolean      @default(true)
  /// Enviar automaticamente quando a primeira sessão do paciente com este profissional for confirmada.
  requireBeforeFirstSession Boolean @default(false)
  createdByUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  requests     DocumentRequest[]

  @@index([professionalId, isActive])
  @@map("document_templates")
}

/// Um documento enviado a um paciente. Registra data, hora, versão, usuário e status (§15).
model DocumentRequest {
  id              String         @id @default(cuid())
  organizationId  String
  professionalId  String
  patientId       String
  appointmentId   String?
  templateId      String
  templateVersion Int
  kind            DocumentKind
  titleSnapshot   String
  /// Texto final que o paciente viu (variáveis já preenchidas). Base do hash.
  bodySnapshot    String
  bodyHash        String // sha256 do bodySnapshot canônico
  tokenHash       String         @unique // token só na mensagem
  status          DocumentStatus @default(PENDING)
  sentAt          DateTime       @default(now())
  viewedAt        DateTime?
  acceptedAt      DateTime?
  expiresAt       DateTime
  revokedAt       DateTime?
  revokeReason    String?
  // Prova do aceite (assinatura eletrônica simples). Anonimização: nome/IP/UA zerados, hash mantido (D6).
  acceptName      String?
  acceptIp        String?
  acceptUserAgent String?
  acceptanceHash  String? // sha256(bodyHash|nome|instante|ip)
  createdByUserId String? // null = envio automático
  createdAt       DateTime       @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment  Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  template     DocumentTemplate @relation(fields: [templateId], references: [id])

  @@index([organizationId, patientId, status])
  @@index([templateId, patientId, status])
  @@index([status, expiresAt])
  @@map("document_requests")
}

// ───────────────────────────────────────────────────────────────
// PORTAL DO PACIENTE (§17, D4: link mágico por WhatsApp) — src/lib/portal/
// Sessão própria, separada do Auth.js: o paciente nunca é um User.
// ───────────────────────────────────────────────────────────────

/// Link mágico: 15 minutos, uso único. Prova a posse do número (a identidade do paciente).
model PatientAccessToken {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  requestIp      String?
  createdAt      DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, expiresAt])
  @@map("patient_access_tokens")
}

/// Sessão do portal (cookie hm_patient = sid). 30 dias; revogável pela recepção.
model PatientSession {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  sid            String    @unique
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  userAgent      String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, revokedAt])
  @@index([expiresAt])
  @@map("patient_sessions")
}

// ───────────────────────────────────────────────────────────────
// COMISSÕES (§25; D3: base = valor recebido) — src/lib/commissions/
// ───────────────────────────────────────────────────────────────

/// Regra vigente por profissional; com serviceId prevalece sobre a geral. Percentual em basis points
/// (1250 = 12,5 %) OU valor fixo por sessão — exatamente um dos dois.
model CommissionRule {
  id             String    @id @default(cuid())
  organizationId String
  professionalId String
  serviceId      String?
  percentBp      Int?
  fixedCents     Int?
  validFrom      DateTime  @db.Date
  validTo        DateTime? @db.Date
  note           String?
  createdByUserId String?
  createdAt      DateTime  @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  entries      CommissionEntry[]

  @@index([organizationId, professionalId, validFrom])
  @@map("commission_rules")
}

enum CommissionEntryKind {
  PAYMENT // gerado por um pagamento recebido (sessão ou pacote)
  REVERSAL // estorno de um pagamento já fechado (linha negativa)
  ADJUSTMENT // ajuste manual (bônus, desconto)
}

/// Um lançamento. Gerado no evento do pagamento; nunca editado. Fechado quando closingId != null.
model CommissionEntry {
  id                String              @id @default(cuid())
  organizationId    String
  professionalId    String
  kind              CommissionEntryKind @default(PAYMENT)
  paymentId         String?
  appointmentId     String?
  packagePurchaseId String?
  ruleId            String?
  baseCents         Int
  amountCents       Int // pode ser negativo (REVERSAL/ADJUSTMENT)
  occurredAt        DateTime
  closingId         String?
  note              String?
  createdByUserId   String?
  createdAt         DateTime            @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  rule         CommissionRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  closing      CommissionClosing? @relation(fields: [closingId], references: [id], onDelete: SetNull)

  @@index([organizationId, professionalId, occurredAt])
  @@index([paymentId])
  @@index([closingId])
  @@map("commission_entries")
}

/// Fechamento de período: imutável. Lançamentos depois do fechamento entram no próximo.
model CommissionClosing {
  id             String   @id @default(cuid())
  organizationId String
  professionalId String
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  totalCents     Int
  entriesCount   Int
  closedAt       DateTime @default(now())
  closedByUserId String
  note           String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  entries      CommissionEntry[]

  @@index([organizationId, professionalId, periodEnd])
  @@map("commission_closings")
}

model PackageConsumption {
  id                String    @id @default(cuid())
  packagePurchaseId String
  appointmentId     String    @unique
  consumedAt        DateTime  @default(now())
  reason            String // "completed" | "no_show"
  revertedAt        DateTime?
  revertReason      String?

  packagePurchase PackagePurchase @relation(fields: [packagePurchaseId], references: [id], onDelete: Cascade)
  appointment     Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([packagePurchaseId, revertedAt])
  @@map("package_consumptions")
}

/// Preparação para emissão de recibos (módulo futuro).
model Receipt {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  patientId     String
  number        String   @unique
  amountCents   Int
  issuedAt      DateTime @default(now())
  pdfUrl        String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

// ───────────────────────────────────────────────────────────────
// NOTIFICAÇÕES / WHATSAPP
// ───────────────────────────────────────────────────────────────

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  REMINDER_24H
  REMINDER_2H
  SESSION_LINK
  CANCELLATION
  RESCHEDULE
  WAITLIST_JOINED // entrou na lista de espera
  WAITLIST_OFFER // surgiu um horário; confirmar pelo link
  FORM_REQUEST // preencher formulário pré-atendimento
  DOCUMENT_REQUEST // ler e aceitar documento (termo, contrato)
  PORTAL_LOGIN // link mágico de acesso ao portal do paciente
  // Avisos ao PROFISSIONAL (canal EMAIL; payload = { subject, text, html })
  PRO_BOOKING_REQUESTED
  PRO_BOOKING_CONFIRMED
  PRO_BOOKING_CANCELLED
  PRO_RESCHEDULE_REQUESTED
  PRO_FORM_SUBMITTED
  PRO_WAITLIST_JOINED
  PRO_WAITLIST_OFFER_ANSWERED
  PRO_DELEGATION_RECEIVED
  PRO_DOCUMENT_ACCEPTED
}

enum NotificationStatus {
  QUEUED
  SENDING // reservada por uma instância do dispatcher
  SENT
  DELIVERED
  READ
  FAILED
}

model Notification {
  id             String  @id @default(cuid())
  organizationId String
  appointmentId  String?
  patientId      String?

  channel NotificationChannel
  type    NotificationType
  status  NotificationStatus  @default(QUEUED)

  recipient         String // telefone E.164 ou e-mail
  templateName      String? // nome do template aprovado na Meta
  payload           Json // variáveis do template — NUNCA dados clínicos
  providerMessageId String?   @unique
  scheduledFor      DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  error             String?
  attempts          Int       @default(0)
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([appointmentId])
  @@map("notifications")
}

/// Eventos brutos recebidos do webhook da Meta (idempotência + auditoria).
model WhatsAppWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String?   @unique // wamid / id do status para deduplicação
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@map("whatsapp_webhook_events")
}

// ───────────────────────────────────────────────────────────────
// DADOS CLÍNICOS (módulo separado, cifrado, acesso restrito)
// ───────────────────────────────────────────────────────────────

enum ClinicalNoteKind {
  EVOLUTION // evolução de uma sessão (vinculada a Appointment)
  NOTE // anotação livre
  ASSESSMENT // avaliação / relatório
}

/// Anotação clínica. `contentEnc` é cifrado com AES-256-GCM em src/lib/crypto.ts.
/// Acesso controlado por src/lib/permissions.ts (canAccessClinicalData).
/// Imutável após criada; exclusão é lógica com motivo (dever de guarda).
model ClinicalNote {
  id             String  @id @default(cuid())
  patientId      String
  professionalId String // profissional responsável
  authorUserId   String // quem escreveu
  appointmentId  String?

  delegationId String? // preenchido quando registrada por substituto

  kind          ClinicalNoteKind @default(NOTE)
  contentEnc    String // base64: iv + tag + ciphertext
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  deletedReason String?

  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional Professional        @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  author       User                @relation(fields: [authorUserId], references: [id])
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  delegation   ClinicalDelegation? @relation(fields: [delegationId], references: [id], onDelete: SetNull)
  accessLogs   ClinicalAccessLog[]

  @@index([patientId, createdAt])
  @@map("clinical_notes")
}

/// Toda leitura de dado clínico gera um registro — exigência de auditoria.
model ClinicalAccessLog {
  id                 String   @id @default(cuid())
  clinicalNoteId     String?
  clinicalDocumentId String?
  formRequestId      String?
  delegationId       String? // acesso feito por delegação (supervisão/substituição)
  userId             String
  action             String // READ | WRITE | DELETE | EXPORT
  ip                 String?
  createdAt          DateTime @default(now())

  clinicalNote     ClinicalNote?       @relation(fields: [clinicalNoteId], references: [id], onDelete: Cascade)
  clinicalDocument ClinicalDocument?   @relation(fields: [clinicalDocumentId], references: [id], onDelete: Cascade)
  delegation       ClinicalDelegation? @relation(fields: [delegationId], references: [id], onDelete: SetNull)
  formRequest      FormRequest?        @relation(fields: [formRequestId], references: [id], onDelete: Cascade)

  @@index([clinicalNoteId, createdAt])
  @@index([clinicalDocumentId, createdAt])
  @@map("clinical_access_logs")
}

enum ClinicalDelegationKind {
  SUPERVISION // supervisor lê
  SUBSTITUTION // substituto lê e registra
}

/// Ato explícito do profissional responsável dando a um colega da mesma
/// organização acesso ao prontuário de um paciente (ou de todos os seus),
/// por prazo determinado. Regras puras em src/lib/clinical-delegation.ts.
model ClinicalDelegation {
  id                     String  @id @default(cuid())
  organizationId         String
  patientId              String? // null = todos os pacientes do titular
  grantorProfessionalId  String // titular do prontuário
  delegateProfessionalId String // quem recebe o acesso
  createdByUserId        String

  kind      ClinicalDelegationKind
  canWrite  Boolean // derivado do tipo (substituição), gravado para auditoria
  reason    String
  startsAt  DateTime
  expiresAt DateTime

  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grantor      Professional @relation("DelegationsGranted", fields: [grantorProfessionalId], references: [id], onDelete: Cascade)
  delegate     Professional @relation("DelegationsReceived", fields: [delegateProfessionalId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  notes      ClinicalNote[]
  documents  ClinicalDocument[]
  accessLogs ClinicalAccessLog[]

  @@index([delegateProfessionalId, expiresAt])
  @@index([grantorProfessionalId, expiresAt])
  @@map("clinical_delegations")
}

enum ClinicalDocumentKind {
  REPORT // laudo / relatório psicológico
  REFERRAL // encaminhamento
  DECLARATION // declaração de comparecimento
  CERTIFICATE // atestado
  CONSENT // termo de consentimento assinado
  EXAM // exame / documento externo trazido pelo paciente
  OTHER
}

/// Anexo do prontuário (PDF ou imagem). O arquivo fica no storage CIFRADO
/// (AES-GCM, src/lib/crypto.ts) — o bucket/disco nunca vê o conteúdo em claro.
/// Título, descrição e nome do arquivo também são cifrados: só kind, tipo e
/// tamanho ficam legíveis no banco.
model ClinicalDocument {
  id             String  @id @default(cuid())
  patientId      String
  professionalId String // profissional responsável
  authorUserId   String
  appointmentId  String?
  delegationId   String? // preenchido quando anexado por substituto

  kind           ClinicalDocumentKind @default(OTHER)
  titleEnc       String
  descriptionEnc String?
  fileNameEnc    String
  contentType    String // application/pdf | image/jpeg | image/png | image/webp
  sizeBytes      Int // do arquivo original (o blob cifrado tem +28 bytes)
  storageKey     String               @unique

  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  deletedReason String?

  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional Professional        @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  author       User                @relation(fields: [authorUserId], references: [id])
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  delegation   ClinicalDelegation? @relation(fields: [delegationId], references: [id], onDelete: SetNull)
  accessLogs   ClinicalAccessLog[]

  @@index([patientId, createdAt])
  @@map("clinical_documents")
}

// ───────────────────────────────────────────────────────────────
// RATE LIMIT
// ───────────────────────────────────────────────────────────────

/// Contador de janela fixa. `key` é um hash (sha256) de escopo + identificador
/// (IP, telefone) — nunca o dado em claro. Ver src/lib/rate-limit.ts.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
  @@map("rate_limits")
}

// ───────────────────────────────────────────────────────────────
// AUDITORIA
// ───────────────────────────────────────────────────────────────

/// Log de login (sucesso e falha).
model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("access_logs")
}

/// Log de alterações em entidades de negócio.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // ex.: "appointment.confirm", "service.update"
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ───────────────────────────────────────────────────────────────
// Lista de espera
// ───────────────────────────────────────────────────────────────

enum WaitlistStatus {
  WAITING
  OFFERED // um horário foi oferecido (agendamento AWAITING_CONFIRMATION vinculado)
  BOOKED // o paciente confirmou o horário oferecido
  REMOVED
}

enum DayPeriod {
  MORNING
  AFTERNOON
  EVENING
}

/// Quem quer um horário que não existe (ainda). Preferências frouxas; a
/// oferta é sempre um ato do profissional (ou recepção) — nunca automática.
/// Regras puras em src/lib/waitlist-match.ts.
model WaitlistEntry {
  id             String  @id @default(cuid())
  organizationId String
  professionalId String
  patientId      String
  serviceId      String?

  modality Modality? // null = qualquer (IN_PERSON | ONLINE)
  weekdays Int[] // 0..6; vazio = qualquer
  periods  DayPeriod[] // vazio = qualquer
  note     String? // administrativo (ex.: "prefere depois das 17h")
  source   AppointmentSource @default(MANUAL) // PUBLIC_PAGE | MANUAL
  priority Boolean           @default(false)

  status               WaitlistStatus @default(WAITING)
  offersCount          Int            @default(0)
  offeredAppointmentId String?        @unique
  offeredAt            DateTime?
  removedReason        String?
  resolvedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional       Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service            Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  offeredAppointment Appointment? @relation(fields: [offeredAppointmentId], references: [id], onDelete: SetNull)

  @@index([professionalId, status, createdAt])
  @@index([patientId, status])
  @@map("waitlist_entries")
}

// ───────────────────────────────────────────────────────────────
// Formulários pré-atendimento
// ───────────────────────────────────────────────────────────────

enum FormKind {
  INTAKE // ficha inicial / anamnese
  CONSENT // termo de consentimento
  QUESTIONNAIRE // questionário / check-in
  CUSTOM
}

/// CLINICAL: respostas cifradas, acesso pelas regras do prontuário.
/// ADMINISTRATIVE: respostas em claro (ex.: termo aceito), visíveis a quem gerencia a agenda.
enum FormDataClass {
  CLINICAL
  ADMINISTRATIVE
}

enum FormRequestStatus {
  PENDING
  SUBMITTED
  EXPIRED
  CANCELLED
}

/// Modelo de formulário de um profissional. `fields` segue src/lib/forms-schema.ts.
model FormTemplate {
  id             String @id @default(cuid())
  organizationId String
  professionalId String

  title                  String
  description            String?
  kind                   FormKind      @default(CUSTOM)
  dataClass              FormDataClass @default(CLINICAL)
  fields                 Json
  /// Enviar automaticamente quando a primeira sessão do paciente com este profissional for confirmada.
  autoSendOnFirstSession Boolean       @default(false)
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  requests     FormRequest[]

  @@index([professionalId, isActive])
  @@map("form_templates")
}

/// Um envio a um paciente. Guarda o snapshot dos campos; o token (hash) é a
/// credencial do link público /formulario/<token>, de uso único.
model FormRequest {
  id              String  @id @default(cuid())
  organizationId  String
  professionalId  String
  patientId       String
  appointmentId   String?
  templateId      String?
  createdByUserId String? // null = envio automático

  titleSnapshot       String
  descriptionSnapshot String?
  dataClass           FormDataClass
  fieldsSnapshot      Json
  tokenHash           String            @unique
  status              FormRequestStatus @default(PENDING)
  sentAt              DateTime          @default(now())
  expiresAt           DateTime
  submittedAt         DateTime?
  submittedIp         String?
  answersEnc          String? // CLINICAL: AES-GCM (src/lib/crypto.ts)
  answersJson         Json? // ADMINISTRATIVE: em claro

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional        @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  template     FormTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  accessLogs   ClinicalAccessLog[]

  @@index([patientId, status])
  @@index([status, expiresAt])
  @@map("form_requests")
}
